    {
      "parameters": {
        "jsCode": "// Every new prospect starts locked: nothing is verified, reviewed or approved for outreach.\nconst existing = new Set();\nfor (const row of $('Load Partnership Tracker').all()) {\n  const nm = row.json['School Name'];\n  if (nm) existing.add((String(nm) + '|' + String(row.json['State'] || '')).toLowerCase());\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst out = [];\n\nfunction addRow(r) {\n  const key = (r.name + '|' + r.state).toLowerCase();\n  if (existing.has(key)) return;\n  existing.add(key);\n  out.push({ json: {\n    'School Name': r.name,\n    'State': r.state,\n    'School Type': r.type,\n    'Website': r.website || '',\n    'SEVP Status': 'Unverified',\n    'Agent Policy': 'Unverified',\n    'Commission Policy': 'Unverified',\n    'Partnership Status': 'Discovered - Needs Verification',\n    'Notes': 'Added ' + today + ' by Partnership OS. Source: ' + r.source + (r.city ? ' | City: ' + r.city : '') + ' | Suggested revenue model: ' + r.fit\n  } });\n}\n\nfor (const item of $input.all()) {\n  const results = Array.isArray(item.json.results) ? item.json.results : (item.json.inst_name ? [item.json] : []);\n  for (const s of results) {\n    const name = s.inst_name;\n    if (!name) continue;\n    // Defensive gates: private nonprofit, active, degree-granting only.\n    if (Number(s.inst_control) !== 2) continue;\n    if (String(s.inst_status) !== '1') continue;\n    if (Number(s.currently_active_ipeds) !== 1) continue;\n    if (Number(s.degree_granting) !== 1) continue;\n    if (s.date_closed && String(s.date_closed) !== '-2') continue;\n    const url = String(s.url_school || '').trim();\n    addRow({\n      id: 'UNIV-' + s.unitid,\n      name: name,\n      type: 'Private University/College',\n      state: s.state_abbr || '',\n      city: s.city || '',\n      website: url && url.indexOf('http') !== 0 ? 'https://' + url : url,\n      source: 'US Dept. of Education IPEDS directory via Urban Institute Education Data Portal (private nonprofit)',\n      fit: 'School-Paid Recruitment (primary); Family-Paid Consulting (secondary)'\n    });\n  }\n}\n\n// Private high schools have no reliable open API: create one research task per state.\nfor (const st of $('Build 50-State Research Plan').all()) {\n  addRow({\n    id: 'HS-QUEUE-' + st.json.state,\n    name: 'Private high school research queue - ' + st.json.stateName,\n    type: 'Private High School (research task)',\n    state: st.json.state,\n    city: '',\n    website: '',\n    source: 'Manual research: NCES Private School Survey + state accreditation lists. Add one row per school.',\n    fit: 'School-Paid Recruitment or Family-Paid Consulting'\n  });\n}\n\nreturn out;"
      },
