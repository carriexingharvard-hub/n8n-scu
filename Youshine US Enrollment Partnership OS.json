    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (!keys.length) { throw new Error('No binary file after decompress'); }\nconst buf = await this.helpers.getBinaryDataBuffer(0, keys[0]);\nconst text = buf.toString('latin1');\nconst splitLine = (line) => {\n  const out = []; let cur = ''; let q = false;\n  for (let i = 0; i < line.length; i++) {\n    const c = line[i];\n    if (c === '\"') { if (q && line[i + 1] === '\"') { cur += '\"'; i++; } else { q = !q; } }\n    else if (c === ',' && !q) { out.push(cur); cur = ''; }\n    else { cur += c; }\n  }\n  out.push(cur);\n  return out;\n};\nconst lines = text.split(/\\r?\\n/);\nconst header = splitLine(lines[0]).map(h => h.trim());\nconst idx = {};\n['PPIN','PINST','PCITY','PSTABB','LEVEL','LOGR2022','HIGR2022','NUMSTUDS','TYPOLOGY','ORIENT','RELIG'].forEach(k => { idx[k] = header.indexOf(k); });\nconst missing = Object.keys(idx).filter(k => idx[k] < 0);\nlet total = 0, badWidth = 0;\nconst byState = {};\nconst rows = [];\nfor (let n = 1; n < lines.length; n++) {\n  if (!lines[n]) continue;\n  const f = splitLine(lines[n]);\n  total++;\n  if (f.length !== header.length) { badWidth++; continue; }\n  const st = f[idx.PSTABB];\n  if (st !== 'CA' && st !== 'MA') continue;\n  byState[st] = byState[st] || { all: 0, secondaryOrCombined: 0 };\n  byState[st].all++;\n  const lvl = f[idx.LEVEL];\n  if (lvl === '2' || lvl === '3') {\n    byState[st].secondaryOrCombined++;\n    rows.push({ ppin: f[idx.PPIN], name: f[idx.PINST], city: f[idx.PCITY], state: st, level: lvl, lowGrade: f[idx.LOGR2022], highGrade: f[idx.HIGR2022], students: f[idx.NUMSTUDS], typology: f[idx.TYPOLOGY] });\n  }\n}\n\nconst selected = ['CA', 'MA'].flatMap(st =>\n  rows\n    .filter(r =>\n      r.state === st &&\n      Number(r.students) >= 100 &&\n      !['9'].includes(String(r.typology))\n    )\n    .sort((a, b) => Number(b.students) - Number(a.students))\n    .slice(0, 10)\n);\nconst existing = new Set(\n  $('Load Partnership Tracker').all()\n    .map(item =>\n      `${String(item.json['School Name'] || '').trim().toUpperCase()}|${String(item.json['State'] || '').trim().toUpperCase()}`\n    )\n);\n\nconst unique = selected.filter(r =>\n  !existing.has(`${String(r.name).trim().toUpperCase()}|${String(r.state).trim().toUpperCase()}`)\n);\nreturn unique.slice(0, 20).map(r => ({\n  json: {\n    \"School Name\": r.name,\n    \"State\": r.state,\n    \"School Type\": \"Private High School\",\n    \"Website\": \"\",\n    \"SEVP Status\": \"Unverified\",\n    \"Agent Policy\": \"Unverified\",\n    \"Commission Policy\": \"Unverified\",\n    \"Partnership Status\": \"Discovered - Needs Verification\",\n    \"Revenue Model\": \"\",\n    \"Notes\": `NCES PSS 2021-22; PPIN: ${r.ppin}; City: ${r.city}; Enrollment: ${r.students}; Boarding: Unverified; Source: https://nces.ed.gov/surveys/pss/; SEVP check: https://studyinthestates.dhs.gov/school-search`\n  }\n}));\n"
      },
