    },
    {
      "parameters": {
        "jsCode": "\nconst html = String($input.first().json.data || '');\n\nconst title = html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i)?.[1]\n  ?.replace(/\\s+/g, ' ').trim() || '';\n\nconst emails = [...new Set(\n  (html.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi) || [])\n    .filter(e => !/\\.(png|jpg|jpeg|gif|webp|svg)$/i.test(e))\n)];\n\nreturn [{\n  json: {\n    \"School Name\": \"The Harker School\",\n    \"State\": \"CA\",\n    \"School Type\": \"Private High School\",\n    \"Website\": \"https://www.harker.org/\",\n    \"Page Title\": title,\n    \"Emails Found (Unverified)\": emails.slice(0, 20),\n    \"SEVP Status\": \"Unverified\",\n    \"Agent Policy\": \"Unverified\",\n    \"Commission Policy\": \"Unverified\",\n    \"Partnership Status\": \"Discovered - Needs Verification\"\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        608
      ],
      "id": "bf6681bd-abcf-4228-ae8d-6c3a13ca392f",
      "name": "Code in JavaScript",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const school = item.json[\"School Name\"] || \"The Harker School\";\n\n  const draft = `Subject: Exploring Educational Collaboration with ${school}\n\nDear Upper School Admissions Team,\n\nI hope this message finds you well.\n\nI'm Carrie, Founder of Youshine Education. Over the past six years, we have supported more than 2,000 families with educational planning and school admissions.\n\nWe would love to explore potential collaboration with ${school}, including educational programs, family engagement, and opportunities to connect prospective students with your school.\n\nWould your team be open to a brief introductory conversation?\n\nWarm regards,\nCarrie\nFounder, Youshine Education`;\n\n  return {\n    json: {\n      ...item.json,\n      \"Contact Email\": \"admissionUS@harker.org\",\n      \"Outreach Draft\": draft,\n      \"Partnership Status\": \"Outreach Drafted - Awaiting Manual Review\"\n    }\n  };\n});\n"
      },
